{
  "name": "afterschool-med-service",
  "version": "1.0.0",
  "description": "课后托管学生用药保管与执行记录服务",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --experimental-sqlite --import tsx watch src/server.ts",
